{
  "name": "yorumi",
  "private": true,
  "version": "5.0.8",
  "description": "Yorumi - Anime & Manga Streamer",
  "author": "davenarchives",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"vite\"",
    "dev:tauri:frontend": "concurrently --kill-others -s first -n backend,vite \"node scripts/tauri-backend.cjs\" \"node scripts/wait-dev-backend.cjs && node scripts/setup-android-reverse.cjs && node scripts/ensure-port-free.cjs 5173 5174 && vite\"",
    "dev:mobile": "concurrently \"npm run dev --prefix backend\" \"vite --host 0.0.0.0\"",
    "build:frontend": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build": "npx esbuild backend/src/index.ts --bundle --platform=node --target=node18 --outfile=backend/dist/bundle.cjs --external:@sparticuz/chromium && tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "android:sync": "npm run build:frontend && cap sync android",
    "ios:sync": "npm run build:frontend && cap sync ios",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && node scripts/run-android-gradle.cjs assembleDebug",
    "android:build:release": "npm run android:sync && node scripts/run-android-gradle.cjs assembleRelease",
    "start": "npm run dev:tauri",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "dev:tauri:android": "node scripts/setup-android-reverse.cjs && tauri android dev",
    "dev:tauri:android:reverse": "node scripts/setup-android-reverse.cjs && tauri android dev --host localhost",
    "dev:tauri:android:open": "node scripts/setup-android-reverse.cjs && tauri android dev --open",
    "build:tauri:android:debug": "tauri android build --debug --apk",
    "build:tauri:android": "tauri android build --apk",
    "test:mappings": "npm exec --prefix backend -- tsx --test tests/anime-mapping.test.ts tests/content-identity.test.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/screen-orientation": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@sparticuz/chromium": "^143.0.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@upstash/redis": "^1.36.1",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "fuzzball": "^2.2.3",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.562.0",
    "puppeteer-core": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fuse.js": "^7.1.0",
    "globals": "^16.5.0",
    "graphql-request": "^7.4.0",
    "knip": "^6.23.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
